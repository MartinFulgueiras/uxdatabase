# ==============================================================================
# Archivo: .env.example
# Propósito: Plantilla segura de variables de entorno para Directus + PostgreSQL
# Uso: cp .env.example .env  >  editar con valores reales
# ==============================================================================
# File: .env.example
# Purpose: Secure environment variables template for Directus + PostgreSQL
# Usage: cp .env.example .env  >  edit with real values
# ==============================================================================

# === Base de datos PostgreSQL ===
# === PostgreSQL Database ===
# Nombre de la base de datos (se crea automáticamente en el primer arranque)
# Database name (created automatically on first run)
DB_DATABASE=uxdb

# Usuario administrador de la base de datos
# Database admin user
DB_USER=uxadmin

# Contraseña segura. Generar con: openssl rand -base64 32
# Secure password. Generate with: openssl rand -base64 32
DB_PASSWORD=ChangeToSecurePassword_123!

# === Directus (Tokens JWT y Sesiones) ===
# === Directus (JWT Tokens & Sessions) ===
# Clave para firmar tokens JWT. Mínimo 32 caracteres hex. Generar con: openssl rand -hex 32
# Key to sign JWT tokens. Minimum 32 hex characters. Generate with: openssl rand -hex 32
DIRECTUS_KEY=

# Clave secreta para encriptación interna y sesiones. Mínimo 64 caracteres hex. Generar con: openssl rand -hex 64
# Secret key for internal encryption and sessions. Minimum 64 hex characters. Generate with: openssl rand -hex 64
DIRECTUS_SECRET=

# === Administrador Inicial (solo aplica en el primer arranque de Directus) ===
# === Initial Admin (only applies on first Directus boot) ===
# Correo del primer usuario administrador
# Email for the first admin user
ADMIN_EMAIL=admin@uxdatabase.local
ADMIN_PASSWORD=ChangeToAdminPassword_2026!

# === Red ===
# === Network ===
# Puerto de acceso a la interfaz web de Directus
# Web interface access port for Directus
DIRECTUS_PORT=8055

# === CONFIGURACIÓN DE ENTORNO Y RED ===
# === NETWORK CONFIGURATION ===
# URL pública de la instancia (usar localhost en desarrollo, IP/Dominio en producción)
# Public URL of the instance (use localhost in development, IP/Domain in production)
# PUBLIC_URL=http://localhost:8055
